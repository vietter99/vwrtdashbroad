#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=01

PROG="/usr/bin/lua /www/vwrt/services/vwrt_watchdog.lua"

start_service() {
	procd_open_instance
	procd_set_param command $PROG
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	logger -t WATCHDOG "Ä ang dá»«ng giÃ¡m sÃ¡t..."
}

reload_service() {
	stop
	start
}
