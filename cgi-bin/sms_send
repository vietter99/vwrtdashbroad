#!/usr/bin/lua
print("Content-type: application/json\n")

local script_path = "/www/vwrt/cgi-bin/"
package.path = script_path .. "?.lua;" .. package.path

local json = require "luci.jsonc"

-- SỬA: Hàm đọc dữ liệu thông minh hơn (hỗ trợ cả Web và Terminal)
function read_post_data()
    local len = os.getenv("CONTENT_LENGTH")
    if len then 
        return io.read(tonumber(len)) 
    else
        -- Fallback: Đọc toàn bộ input (dùng cho test CLI)
        return io.read("*a")
    end
end

local input = read_post_data()
if not input or input == "" then
    print(json.stringify({status="error", message="No input data"}))
    os.exit()
end

local data = json.parse(input)
if not data or not data.number or not data.text then
    print(json.stringify({status="error", message="Missing number or text"}))
    os.exit()
end

local function get_config()
    local cfg = { driver = "mmcli", at_port = "" }
    local f = io.popen("uci get vwrt.modem.driver 2>/dev/null")
    local drv = f:read("*a")
    f:close()
    if drv and drv:len() > 1 then cfg.driver = drv:gsub("[\r\n]", "") end

    local f2 = io.popen("uci get vwrt.modem.at_port 2>/dev/null")
    local port = f2:read("*a")
    f2:close()
    if port and port:len() > 1 then cfg.at_port = port:gsub("[\r\n]", "") end
    return cfg
end

local config = get_config()
local status, driver_lib

if config.driver == "fm350" then
    status, driver_lib = pcall(require, "drivers.fm350")
else
    status, driver_lib = pcall(require, "drivers.mmcli")
end

if not status then
    status, driver_lib = pcall(require, "drivers." .. config.driver)
    if not status then
        print(json.stringify({status="error", message="Driver not found: " .. config.driver}))
        os.exit()
    end
end

local result = driver_lib.send_sms(config, data.number, data.text)
print(json.stringify(result))