#!/usr/bin/lua

local cjson = require "cjson"

local cache_file = "/tmp/vwrt_mobile.json"

function read_file(path)
    local f = io.open(path, "r")
    if not f then return nil end
    local content = f:read("*all")
    f:close()
    return content
end

function get_data()
    local content = read_file(cache_file)
    local data = {}
    
    if content and content ~= "" then
        local ok, parsed = pcall(cjson.decode, content)
        if ok and parsed then
            data = parsed
        end
    end

    -- Fix: Get WAN IP Address
    local wan_iface = data.iface or "wwan0"
    local handle = io.popen("ip -4 addr show " .. wan_iface .. " | grep -oP '(?<=inet\\s)\\d+(\\.\\d+){3}'")
    local wan_ip = handle:read("*l")
    handle:close()
    
    data.wan_ip = wan_ip or "Unknown"

    if not data.operator_name then
        data.operator_name = "Loading..."
        data.signal = "0"
        data.mode = "Checking..."
    end

    return { status = "success", data = data }
end

print("Content-type: application/json\n\n")
print(cjson.encode(get_data()))