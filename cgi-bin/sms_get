#!/usr/bin/lua
print("Content-type: application/json\n")

-- Thêm đường dẫn để tìm thấy driver
local script_path = "/www/vwrt/cgi-bin/"
package.path = script_path .. "?.lua;" .. package.path

local json = require "luci.jsonc"

local function get_config()
    local cfg = { driver = "mmcli", at_port = "" }
    local f = io.popen("uci get vwrt.modem.driver 2>/dev/null")
    local drv = f:read("*a")
    f:close()
    if drv and drv:len() > 1 then cfg.driver = drv:gsub("[\r\n]", "") end

    local f2 = io.popen("uci get vwrt.modem.at_port 2>/dev/null")
    local port = f2:read("*a")
    f2:close()
    if port and port:len() > 1 then cfg.at_port = port:gsub("[\r\n]", "") end
    return cfg
end

local config = get_config()
local status, driver_lib

-- TỰ ĐỘNG LOAD DRIVER DỰA VÀO CẤU HÌNH

local target_driver = (config.driver and config.driver ~= "") and config.driver or "mmcli"

status, driver_lib = pcall(require, "drivers." .. target_driver)

if not status and target_driver ~= "mmcli" then
    status, driver_lib = pcall(require, "drivers.mmcli")
end

if not status then
    print(json.stringify({ status = "error", message = "Driver load failed for: " .. target_driver }))
    os.exit()
end

-- Lấy tin nhắn từ driver
local messages = driver_lib.get_sms(config)
local response = {
    status = "success",
    data = messages
}

print(json.stringify(response))