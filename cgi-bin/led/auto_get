#!/usr/bin/lua
local json = require("luci.jsonc")
local f = io.open("/etc/vwrt_autoled.json", "r")
local content = "{}"
if f then
    content = f:read("*all")
    f:close()
    -- Strip UTF-8 BOM if present (EF BB BF)
    if content:sub(1,3) == "\239\187\191" then
        content = content:sub(4)
    end
end
print("Content-Type: application/json")
print("")
print(content)
