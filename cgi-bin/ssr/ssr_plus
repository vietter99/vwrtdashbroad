#!/usr/bin/lua

-- Fix package path to include the current directory
local source = debug.getinfo(1).source
local script_path = source:match("@?(.*[\\/])")
if script_path then package.path = script_path .. "?.lua;" .. package.path end

local vwrth = require "vwrth"
local params = vwrth.get_params()
local action = params.action or "get_info"

print("Content-type: application/json\n\n")

function format_dns_for_display(dns_str)
    if not dns_str or dns_str == "" then return "" end
    local results = {}
    for ip in dns_str:gmatch("([^,%s]+)") do
        ip = ip:gsub("^%w+://", ""):gsub(":53$", "")
        table.insert(results, ip)
    end
    return table.concat(results, ", ")
end

local function log_debug(msg)
    local f = io.open("/tmp/ssr_plus_debug.log", "a")
    if f then
        f:write(os.date("%H:%M:%S") .. " [DEBUG] " .. tostring(msg) .. "\n")
        f:close()
    end
end

local function get_global_sid(all)
    -- Ưu tiên các section có pdnsd_enable (chuẩn LuCI)
    for k, v in pairs(all) do
        if v.pdnsd_enable then return k end
    end
    -- Fallback tìm theo global_server nếu pdnsd_enable chưa có
    for k, v in pairs(all) do
        if v.global_server then return k end
    end
    return "@global[0]"
end

if action == "get_info" then
    if os.execute("test -f /etc/config/shadowsocksr") ~= 0 then
        print(vwrth.json_encode({status = "uninstalled", message = "Tính năng này chưa được kích hoạt."}))
        return
    end

    local data = { status = "success", global = {}, adv = {}, sub = {}, servers = {} }
    local all = vwrth.uci_get_all("shadowsocksr")
    
    -- Find global section
    local g = {}
    for k, v in pairs(all) do if v.pdnsd_enable then g = v break end end

    local dns_mode = g.pdnsd_enable or "1"
    local tunnel_dns = g.tunnel_forward or "8.8.4.4:53"
    if dns_mode == "4" then tunnel_dns = g.tunnel_forward_mosdns or tunnel_dns
    elseif dns_mode == "6" then tunnel_dns = g.chinadns_ng_tunnel_forward or tunnel_dns end

    data.global = {
        enable = g.enable_switch or "0",
        main_server = g.global_server or "nil",
        udp_server = g.udp_relay_server or "same",
        run_mode = g.run_mode or "all",
        dns_mode = dns_mode,
        tunnel_dns = format_dns_for_display(tunnel_dns),
        tunnel_dns_raw = tunnel_dns,
        threads = g.threads or "0",
        dports = g.dports or "1",
        -- Kiểm tra tiến trình thực tế (Sửa lỗi báo cáo trạng thái ảo)
        running = os.execute("pgrep -x ssr-plus >/dev/null 2>&1 || pgrep -x ssr-redir >/dev/null 2>&1") == 0,
        -- Thêm thông tin thời gian vào data trả về
        time_server = g.time_server or "m.tv360.vn",
        time_startup = g.time_startup or "0",
        time_cron = g.time_cron or "0"
    }



    -- Get Advanced (Fragment & Noise)
    local xfrag = {}
    vwrth.uci_foreach("shadowsocksr", "global_xray_fragment", function(s) xfrag = s end)
    local xnoise = {}
    vwrth.uci_foreach("shadowsocksr", "xray_noise_packets", function(s) xnoise = s end)

    data.adv = {
        frag_enable = xfrag.fragment or "0",
        frag_packets = xfrag.fragment_packets or "",
        frag_length = xfrag.fragment_length or "",
        frag_interval = xfrag.fragment_interval or "",
        frag_maxsplit = xfrag.fragment_maxSplit or "",

        noise_enable = xfrag.noise or "0",
        noise_type = xnoise.type or "",
        noise_packet = xnoise.packet or "",
        noise_delay = xnoise.delay or "",
        noise_apply = xnoise.applyto or ""
    }

    -- Get Servers
    vwrth.uci_foreach("shadowsocksr", "servers", function(s)
        table.insert(data.servers, {
            id = s[".name"],
            alias = s.alias or "No Alias",
            type = (s.type or "unknown"):upper(),
            address = s.server or "",
            port = s.server_port or "80"
        })
    end)

    data.running = (os.execute("/usr/bin/pgrep -x xray >/dev/null") or os.execute("/usr/bin/pgrep -x v2ray >/dev/null") or os.execute("/usr/bin/pgrep -f ssr-redir >/dev/null")) and 1 or 0
    print(vwrth.json_encode(data))

elseif action == "ping_node" then
    local host = params.host
    local port = tonumber(params.port or 0)
    
    if not host or host == "" then
        print(vwrth.json_encode({status = "error", message = "Thiếu host"}))
        return
    end

    -- 1. Whitelist Firewall Logic (Matched with Router's Original Luci)
    local use_nft = os.execute("command -v nft >/dev/null 2>&1") == 0
    local iret = false

    if use_nft then
        iret = os.execute("nft add element inet ss_spec ss_spec_wan_ac { " .. host .. " } 2>/dev/null") == 0
    else
        iret = os.execute("ipset add ss_spec_wan_ac " .. host .. " 2>/dev/null") == 0
    end

    -- 2. Measured Ping
    local success = false
    local latency = "0"
    
    if port > 0 then
        -- Dùng tcping và lấy trực tiếp con số ms
        local output = vwrth.exec(string.format("tcping -q -c 1 -t 2 -p %d %s 2>/dev/null | grep -o 'time=[0-9]*' | cut -d= -f2", port, host))
        if output and output ~= "" then
            latency = output:gsub("\n", "")
            success = true
        end
    end

    if not success then
        -- Fallback ping ICMP
        local output = vwrth.exec(string.format("ping -c 1 -W 1 %s 2>/dev/null | grep -o 'time=[0-9.]*' | cut -d= -f2", host))
        if output and output ~= "" then
            latency = math.floor(tonumber(output:gsub("\n", "")) or 0)
            success = true
        end
    end

    -- 3. Cleanup Firewall
    if iret then
        if use_nft then
            os.execute("nft delete element inet ss_spec ss_spec_wan_ac { " .. host .. " } 2>/dev/null")
        else
            os.execute("ipset del ss_spec_wan_ac " .. host .. " 2>/dev/null")
        end
    end

    if success then
        print(vwrth.json_encode({status = "success", time = latency}))
    else
        print(vwrth.json_encode({status = "error", message = "Timeout"}))
    end

elseif action == "get_log" then
    -- CHỈ lấy Nhật ký của Proxy (v1.9.3 Fix)
    local log = vwrth.exec("cat /tmp/ssr_plus_debug.log 2>/dev/null | tail -n 100")
    if log == "" then log = "Proxy chưa có nhật ký hoạt động." end
    print(vwrth.json_encode({status = "success", log = log}))

elseif action == "delete_server" then
    local id = params.id
    if id then
        os.execute("uci delete shadowsocksr." .. id)
        vwrth.uci_commit("shadowsocksr")
        print(vwrth.json_encode({status = "success", message = "Đã xóa máy chủ"}))
    else
        print(vwrth.json_encode({status = "error", message = "Thiếu ID máy chủ"}))
    end

elseif action == "update_sub" then
    -- Trigger subscription update in background
    os.execute("lua /usr/share/shadowsocksr/subscribe.lua >/dev/null 2>&1 &")
    print(vwrth.json_encode({status = "success", message = "Đang cập nhật Subscription ngầm..."}))

elseif action == "delete_sub_nodes" then
    -- Delete all servers that were added via subscription
    vwrth.uci_foreach("shadowsocksr", "servers", function(s)
        if s.subscribe then
            os.execute("uci delete shadowsocksr." .. s[".name"])
        end
    end)
    vwrth.uci_commit("shadowsocksr")
    print(vwrth.json_encode({status = "success", message = "Đã xóa toàn bộ Node đăng ký"}))

elseif action == "import_nodes" then
    local links = params.links or ""
    local count = 0
    
    local function url_decode(s)
        if not s then return "" end
        s = s:gsub("+", " "):gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end)
        return s
    end

    local function parse_query(q)
        local res = {}
        for pair in q:gmatch("([^&]+)") do
            local k, v = pair:match("([^=]+)=([^=]+)")
            if k and v then res[k] = url_decode(v) end
        end
        return res
    end

    for link in links:gmatch("[^\r\n]+") do
        link = link:gsub("%s+", "")
        if link ~= "" then
            -- Tạo SID an toàn không dùng shell exec
            local sid = "cfg" .. string.sub(vwrth.exec("echo -n '" .. link .. "' | md5sum | cut -d' ' -f1") or "00000000", 1, 8)
            sid = sid:gsub("%s+", "")
            
            local proto = link:match("^(%w+)://")
            local cmds = {}
            local success = false
            
            table.insert(cmds, string.format("uci set shadowsocksr.%s=servers", sid))
            
            if proto == "vless" or proto == "trojan" then
                local main, alias = link:match("^%w+://([^#]+)#?(.*)")
                local host_part, query_str = main:match("([^?]+)%??(.*)")
                if not host_part then host_part = main; query_str = "" end
                
                local user, server_info = host_part:match("([^@]+)@(.+)")
                if user and server_info then
                    local host, port = server_info:match("([^:]+):(%d+)")
                    if not host then host = server_info; port = (proto == "trojan") and "443" or "80" end
                    
                    local q = parse_query(query_str)
                    alias = alias ~= "" and url_decode(alias) or host

                    table.insert(cmds, string.format("uci set shadowsocksr.%s.alias='%s'", sid, alias:gsub("'", "")))
                    table.insert(cmds, string.format("uci set shadowsocksr.%s.server='%s'", sid, host))
                    table.insert(cmds, string.format("uci set shadowsocksr.%s.server_port='%s'", sid, port))
                    table.insert(cmds, string.format("uci set shadowsocksr.%s.local_port='1234'", sid))
                    table.insert(cmds, string.format("uci set shadowsocksr.%s.timeout='300'", sid))
                    table.insert(cmds, string.format("uci set shadowsocksr.%s.fast_open='0'", sid))
                    table.insert(cmds, string.format("uci set shadowsocksr.%s.udp_relay='1'", sid))
                    table.insert(cmds, string.format("uci set shadowsocksr.%s.switch_enable='1'", sid))
                    
                    if proto == "vless" then
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.type='v2ray'", sid))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.v2ray_protocol='vless'", sid))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.v2ray_vless_id='%s'", sid, user))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.vless_encryption='%s'", sid, q.encryption or "none"))
                    else
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.type='trojan'", sid))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.password='%s'", sid, user))
                    end

                    local transport = q.type or "tcp"
                    if transport == "http" then transport = "h2"
                    elseif transport == "tcp" or transport == "raw" then transport = "raw" end
                    table.insert(cmds, string.format("uci set shadowsocksr.%s.transport='%s'", sid, transport))

                    if q.security == "tls" or q.security == "xtls" or q.security == "reality" then
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.tls='1'", sid))
                        if q.security == "reality" then 
                            table.insert(cmds, string.format("uci set shadowsocksr.%s.reality='1'", sid))
                            if q.pbk then table.insert(cmds, string.format("uci set shadowsocksr.%s.reality_publickey='%s'", sid, q.pbk)) end
                            if q.sid then table.insert(cmds, string.format("uci set shadowsocksr.%s.reality_shortid='%s'", sid, q.sid)) end
                        end
                        if q.sni then table.insert(cmds, string.format("uci set shadowsocksr.%s.tls_host='%s'", sid, q.sni)) end
                        if q.fp then table.insert(cmds, string.format("uci set shadowsocksr.%s.fingerprint='%s'", sid, q.fp)) end
                    end

                    if transport == "ws" then
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.ws_host='%s'", sid, q.host or ""))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.ws_path='%s'", sid, q.path or "/"))
                    elseif transport == "h2" then
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.h2_host='%s'", sid, q.host or ""))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.h2_path='%s'", sid, q.path or "/"))
                    elseif transport == "grpc" then
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.serviceName='%s'", sid, q.serviceName or ""))
                    end
                    success = true
                end
                
            elseif proto == "vmess" then
                local b64 = link:match("vmess://(.+)")
                if b64 then
                    local json_raw = vwrth.exec("echo -n '" .. b64 .. "' | base64 -d 2>/dev/null")
                    if json_raw and json_raw ~= "" then
                        local function extract(field)
                            return json_raw:match('"' .. field .. '"%s*:%s*"([^"]+)"') or ""
                        end
                        
                        local alias = extract("ps")
                        local host = extract("add")
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.type='v2ray'", sid))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.v2ray_protocol='vmess'", sid))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.server='%s'", sid, host))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.server_port='%s'", sid, extract("port")))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.vmess_id='%s'", sid, extract("id")))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.alias='%s'", sid, (alias ~= "" and alias or host):gsub("'", "")))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.local_port='1234'", sid))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.timeout='300'", sid))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.fast_open='0'", sid))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.udp_relay='1'", sid))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.switch_enable='1'", sid))
                        
                        local net = extract("net")
                        local transport = net
                        if net == "tcp" or net == "raw" or net == "" then transport = "raw" 
                        elseif net == "http" then transport = "h2" end
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.transport='%s'", sid, transport))
                        
                        if transport == "ws" then
                            table.insert(cmds, string.format("uci set shadowsocksr.%s.ws_host='%s'", sid, extract("host")))
                            table.insert(cmds, string.format("uci set shadowsocksr.%s.ws_path='%s'", sid, extract("path")))
                        elseif transport == "h2" then
                            table.insert(cmds, string.format("uci set shadowsocksr.%s.h2_host='%s'", sid, extract("host")))
                            table.insert(cmds, string.format("uci set shadowsocksr.%s.h2_path='%s'", sid, extract("path")))
                        end

                        if extract("tls") == "tls" then
                            table.insert(cmds, string.format("uci set shadowsocksr.%s.tls='1'", sid))
                            local sni = extract("sni")
                            if sni == "" then sni = extract("host") end
                            if sni ~= "" then table.insert(cmds, string.format("uci set shadowsocksr.%s.tls_host='%s'", sid, sni)) end
                        end
                        success = true
                    end
                end
                
            elseif proto == "ssr" then
                local b64 = link:match("ssr://(.+)")
                if b64 then
                    local plain = vwrth.exec("echo -n '" .. b64 .. "' | base64 -d 2>/dev/null")
                    local host, port, protocol, method, obfs, b64pass, rest = plain:match("([^:]+):([^:]+):([^:]+):([^:]+):([^:]+):([^/]+)/?(.*)")
                    if host then
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.type='ssr'", sid))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.server='%s'", sid, host))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.server_port='%s'", sid, port))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.protocol='%s'", sid, protocol))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.encrypt_method='%s'", sid, method))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.obfs='%s'", sid, obfs))
                        table.insert(cmds, string.format("uci set shadowsocksr.%s.password='%s'", sid, vwrth.exec("echo -n '" .. b64pass .. "' | base64 -d 2>/dev/null")))
                        
                        local remarks = rest and rest:match("remarks=([^&]+)")
                        if remarks then
                            local alias = vwrth.exec("echo -n '" .. remarks .. "' | base64 -d 2>/dev/null")
                            table.insert(cmds, string.format("uci set shadowsocksr.%s.alias='%s'", sid, alias:gsub("'", "")))
                        else
                            table.insert(cmds, string.format("uci set shadowsocksr.%s.alias='%s'", sid, host))
                        end
                        success = true
                    end
                end
            end
            
            if success then
                os.execute(table.concat(cmds, " && "))
                count = count + 1
            else
                os.execute(string.format("uci set shadowsocksr.%s.alias='Unknown_%s'; uci set shadowsocksr.%s.server='%s'", sid, os.time(), sid, link))
            end
        end
    end
    vwrth.uci_commit("shadowsocksr")
    print(vwrth.json_encode({status = "success", message = "Đã thêm thành công " .. count .. " máy chủ vào danh sách."}))

elseif action == "get_time" then
    print(vwrth.json_encode({status = "success", now = os.date("%d-%m-%Y %H:%M:%S")}))

elseif action == "sync_time" then
    local host = params.host or "m.tv360.vn"
    -- Sử dụng ntpd để đồng bộ ngay lập tức
    os.execute("ntpd -q -p " .. host .. " >/dev/null 2>&1")
    print(vwrth.json_encode({status = "success", message = "Đã đồng bộ thời gian với " .. host}))

elseif action == "set_time" then
    local time_str = params.time
    if time_str then
        -- time_str format: "YYYY-MM-DD HH:MM:SS" (ví dụ gửi từ browser)
        -- Chuyển đổi định dạng cho lệnh date -s của BusyBox
        -- date -s "YYYY-MM-DD HH:MM:SS"
        os.execute(string.format("date -s '%s' >/dev/null 2>&1", time_str))
        print(vwrth.json_encode({status = "success", message = "Đã cập nhật giờ từ trình duyệt"}))
    else
        print(vwrth.json_encode({status = "error", message = "Thiếu thông tin thời gian"}))
    end

elseif action == "save_config" or action == "set_server" then
    local all_cfg = vwrth.uci_get_all("shadowsocksr")
    local sid = get_global_sid(all_cfg)
    local target_id = params.id or params.server
    
    log_debug("Action: " .. action .. " | SID: " .. sid .. " | Target ID: " .. (target_id or "nil"))
    
    if target_id then 
        vwrth.uci_set("shadowsocksr", sid, "global_server", target_id)
        vwrth.uci_set("shadowsocksr", sid, "udp_relay_server", target_id)
    end
    if params.enable then vwrth.uci_set("shadowsocksr", sid, "enable_switch", params.enable) end
    if params.mode then vwrth.uci_set("shadowsocksr", sid, "run_mode", params.mode) end
    if params.udp then vwrth.uci_set("shadowsocksr", sid, "udp_relay_server", params.udp) end
    
    -- Các tham số Cài đặt chung 
    if params.threads then vwrth.uci_set("shadowsocksr", sid, "threads", params.threads) end
    if params.dports then vwrth.uci_set("shadowsocksr", sid, "dports", params.dports) end
    
    -- DNS Logic chuẩn LuCI (bảo toàn format gốc)
    if params.dns_mode then
        vwrth.uci_set("shadowsocksr", sid, "pdnsd_enable", params.dns_mode)
        if params.tunnel and params.tunnel ~= "" then
            -- Khôi phục format chuẩn LuCI nếu người dùng chỉ nhập IP thô
            local dns_val = params.tunnel
            if params.dns_mode == "4" then
                -- MOSDNS cần format: tcp://IP:53,tcp://IP:53
                if not dns_val:find("tcp://") then
                    local parts = {}
                    for ip in dns_val:gmatch("([^,%s]+)") do
                        ip = ip:gsub(":53$", "")
                        table.insert(parts, "tcp://" .. ip .. ":53")
                    end
                    dns_val = table.concat(parts, ",")
                end
                vwrth.uci_set("shadowsocksr", sid, "tunnel_forward_mosdns", dns_val)
            elseif params.dns_mode == "1" or params.dns_mode == "2" or params.dns_mode == "3" then
                -- PDNSD/DNS2SOCKS/DoH cần format: IP:53
                if not dns_val:find(":") then
                    dns_val = dns_val .. ":53"
                end
                vwrth.uci_set("shadowsocksr", sid, "tunnel_forward", dns_val)
            elseif params.dns_mode == "5" then
                vwrth.uci_set("shadowsocksr", sid, "dnsproxy_tunnel_forward", dns_val)
            elseif params.dns_mode == "6" then
                vwrth.uci_set("shadowsocksr", sid, "chinadns_ng_tunnel_forward", dns_val)
            end
        end
    end

    -- Lưu cấu hình Thời gian và cập nhật Cron
    if params.time_server then vwrth.uci_set("shadowsocksr", sid, "time_server", params.time_server) end
    if params.time_startup then vwrth.uci_set("shadowsocksr", sid, "time_startup", params.time_startup) end
    if params.time_cron then 
        vwrth.uci_set("shadowsocksr", sid, "time_cron", params.time_cron)
        local server = params.time_server or "m.tv360.vn"
        os.execute("touch /etc/crontabs/root")
        os.execute("sed -i '/timewrt/d' /etc/crontabs/root")
        local cmd = "/www/vwrt/cgi-bin/system/timewrt " .. server .. " cron"
        if params.time_cron == "m5" then os.execute("echo '*/5 * * * * " .. cmd .. "' >> /etc/crontabs/root")
        elseif params.time_cron == "m15" then os.execute("echo '*/15 * * * * " .. cmd .. "' >> /etc/crontabs/root")
        elseif params.time_cron == "m30" then os.execute("echo '*/30 * * * * " .. cmd .. "' >> /etc/crontabs/root")
        elseif params.time_cron == "1" then os.execute("echo '0 * * * * " .. cmd .. "' >> /etc/crontabs/root")
        elseif params.time_cron == "6" then os.execute("echo '0 */6 * * * * " .. cmd .. "' >> /etc/crontabs/root")
        elseif params.time_cron == "12" then os.execute("echo '0 */12 * * * * " .. cmd .. "' >> /etc/crontabs/root")
        elseif params.time_cron == "24" then os.execute("echo '0 4 * * * " .. cmd .. "' >> /etc/crontabs/root")
        end
        os.execute("/etc/init.d/cron restart")
        os.execute("sed -i '/timewrt/d' /etc/rc.local")
        if params.time_startup == "1" then
            os.execute("sed -i '/exit 0/i /www/vwrt/cgi-bin/system/timewrt " .. server .. " &' /etc/rc.local")
        end
    end
    

    
    -- Lưu cấu hình Xray Fragment và UDP Noise (Tab Nâng cao) - CHUẨN LỰA CHỌN HELLOWORLD
    if params.frag_enable then
        local xf_sid = "@global_xray_fragment[0]"
        -- Đảm bảo section tồn tại theo chuẩn UCI set
        vwrth.uci_set("shadowsocksr", xf_sid, "fragment", params.frag_enable)
        if params.frag_packets then vwrth.uci_set("shadowsocksr", xf_sid, "fragment_packets", params.frag_packets) end
        if params.frag_length then vwrth.uci_set("shadowsocksr", xf_sid, "fragment_length", params.frag_length) end
        if params.frag_interval then vwrth.uci_set("shadowsocksr", xf_sid, "fragment_interval", params.frag_interval) end
        if params.frag_maxsplit then vwrth.uci_set("shadowsocksr", xf_sid, "fragment_maxSplit", params.frag_maxsplit) end
        
        vwrth.uci_set("shadowsocksr", xf_sid, "noise", params.noise_enable or "0")
    end

    if params.noise_enable then
        local xn_sid = "@xray_noise_packets[0]"
        if params.noise_type then vwrth.uci_set("shadowsocksr", xn_sid, "type", params.noise_type) end
        if params.noise_packet then vwrth.uci_set("shadowsocksr", xn_sid, "packet", params.noise_packet) end
        if params.noise_delay then vwrth.uci_set("shadowsocksr", xn_sid, "delay", params.noise_delay) end
        if params.noise_apply then vwrth.uci_set("shadowsocksr", xn_sid, "domainStrategy", params.noise_apply) end
    end
    


    -- TỰ ĐỘNG VÁ LỖI HỆ THỐNG: Hotfix lỗi gen_config.lua của OpenWrt (Phiên bản v2.0 - Siêu bám dính)
    -- Sử dụng Lua Pattern để nhận diện xuyên không gian (cả Tab, CRLF, LF)
    os.execute([[
    lua -e '
        local f = io.open("/usr/share/shadowsocksr/gen_config.lua", "r")
        if f then
            local data = f:read("*all")
            f:close()
            local old_pattern = "settings%s*=%s*%{%s*domainStrategy%s*=%s*%(xray_fragment%.noise%s*==%s*\"1\"%s*and%s*xray_noise%.enabled%s*==%s*\"1\"%)%s*and%s*n_domainstrategy%s*or%s*nil%s*%},"
            if data:find(old_pattern) then
                local new_str = "settings = (xray_fragment.noise == \"1\" and xray_noise.enabled == \"1\" and n_domainstrategy and n_domainstrategy ~= \"\") and { domainStrategy = n_domainstrategy } or nil,"
                data = data:gsub(old_pattern, new_str)
                local out = io.open("/usr/share/shadowsocksr/gen_config.lua", "w")
                if out then out:write(data); out:close() end
            end
        end
    '
    ]])

    vwrth.uci_commit("shadowsocksr")
    os.execute("/etc/init.d/shadowsocksr restart >/dev/null 2>&1 &")
    print(vwrth.json_encode({status = "success", message = "Cấu hình chung đã cập nhật"}))

elseif action == "delete_server" or action == "delete_node" then
    local id = params.id
    if id then
        os.execute("uci delete shadowsocksr." .. id)
        vwrth.uci_commit("shadowsocksr")
        print(vwrth.json_encode({status = "success", message = "Đã xóa máy chủ"}))
    else
        print(vwrth.json_encode({status = "error", message = "Thiếu ID máy chủ"}))
    end

elseif action == "ping" then
    local host = params.host
    if host then
        -- Chạy lệnh ping và lấy toàn bộ kết quả trả về
        local output = vwrth.exec("ping -c 1 -W 2 " .. host .. " 2>&1")
        -- Dùng Lua để tìm con số đứng sau "time="
        local latency = output:match("time=([%d%.]+)")
        
        if latency then
            -- Làm tròn và thêm đơn vị ms
            print(vwrth.json_encode({status = "success", latency = math.floor(tonumber(latency) or 0) .. "ms"}))
        else
            print(vwrth.json_encode({status = "success", latency = "Timeout"}))
        end
    else
        print(vwrth.json_encode({status = "error", message = "Thiếu Host"}))
    end

elseif action == "install" then
    -- Lệnh kích hoạt và cài đặt Proxy
    os.execute("/etc/init.d/shadowsocksr enable 2>/dev/null")
    os.execute("/etc/init.d/shadowsocksr restart 2>/dev/null")
    -- Kiểm tra lại sau khi cài đặt
    if os.execute("test -f /etc/config/shadowsocksr") == 0 then
        print(vwrth.json_encode({status = "success", message = "Đã cài đặt và kích hoạt Proxy thành công!"}))
    else
        print(vwrth.json_encode({status = "error", message = "Không tìm thấy gói shadowsocksr-plus trên hệ thống. Vui lòng cài đặt qua OPKG trước."}))
    end

else
    print(vwrth.json_encode({status = "error", message = "Hành động không xác định"}))
end
