#!/bin/sh
echo 'Content-type: application/json'
echo ''

# CHUYỂN LOG SANG BỘ NHỚ FLASH ĐỂ KHÔNG MẤT KHI REBOOT
LOG_FILE='/www/vwrt/vpn_install.log'
LOCK_FILE='/tmp/vpn_install.lock'
DEBUG_LOG='/tmp/vpn_debug.log'
URL="https://raw.githubusercontent.com/vietter99/vpnvwrt/master"
TMP_DIR="/tmp/core_update"

get_action() {
    echo "$QUERY_STRING" | grep -oE "action=[^&]+" | cut -d= -f2
}

ACTION=$(get_action)

if [ "$ACTION" = "status" ]; then
    if [ ! -f "$LOCK_FILE" ]; then
        if [ -f "$LOG_FILE" ] && grep -q "SUCCESS" "$LOG_FILE"; then
            echo '{"status":"success", "message":"CÀI ĐẶT HOÀN TẤT!"}'
        elif [ -f "$LOG_FILE" ] && grep -q "ERROR" "$LOG_FILE"; then
            MSG=$(tail -n 1 "$LOG_FILE")
            echo "{\"status\":\"error\", \"message\":\"$MSG\"}"
        else
            echo '{"status":"idle"}'
        fi
    else
        PROGRESS=$(tail -n 1 "$LOG_FILE" 2>/dev/null || echo "Đang khởi tạo...")
        echo "{\"status\":\"running\", \"progress\":\"$PROGRESS\"}"
    fi
    exit 0
fi

if [ -f "$LOCK_FILE" ]; then
    echo '{"status":"running", "message":"Cài đặt đang tiến hành..."}'
    exit 0
fi

touch "$LOCK_FILE"
echo "BẮT ĐẦU: Kết nối kho dữ liệu VWRT..." > "$LOG_FILE"

(
    # BẮT BUỘC: Cập nhật danh sách gốc
    echo "Đang chuẩn bị dữ liệu (1/18)..." >> "$LOG_FILE"
    opkg update > "$DEBUG_LOG" 2>&1
    if [ $? -ne 0 ]; then
        echo "ERROR: Lỗi đồng bộ hệ thống!" >> "$LOG_FILE"
        rm -f "$LOCK_FILE"
        exit 1
    fi

    # Bước 0: Cài đặt các gói nền tảng từ official repo của ImmortalWrt
    echo "Đang chuẩn bị dữ liệu (2/18)..." >> "$LOG_FILE"
    # Kiểm tra xem các gói nền đã có chưa để tiết kiệm thời gian
    opkg install ip-full coreutils-base64 coreutils-nohup luci-compat luci-lib-ipkg jq nping >> "$DEBUG_LOG" 2>&1

    # Bước 1: Xử lý Dnsmasq (Bắt buộc phải là dnsmasq-full)
    if ! opkg list-installed | grep -q "dnsmasq-full"; then
        echo "Đang chuẩn bị dữ liệu (3/18)..." >> "$LOG_FILE"
        opkg remove dnsmasq --force-remove >> "$DEBUG_LOG" 2>&1
        opkg install dnsmasq-full >> "$DEBUG_LOG" 2>&1
    fi

    rm -rf $TMP_DIR && mkdir -p $TMP_DIR
    cd $TMP_DIR
    
    FILES="luci-app-ssr-plus_190-r126_all.ipk xray-core_25.12.8-r35_aarch64_cortex-a53.ipk luci-app-mosdns_1.6.16-r18_all.ipk mosdns_5.3.3-r82_aarch64_cortex-a53.ipk dns2socks_2.1-r4_aarch64_cortex-a53.ipk dns2tcp_1.1.2-r2_aarch64_cortex-a53.ipk lua-neturl_1.2.1-r4_all.ipk microsocks_1.0.5-r3_aarch64_cortex-a53.ipk shadowsocks-rust-sslocal_1.24.0-r14_aarch64_cortex-a53.ipk shadowsocks-rust-ssserver_1.24.0-r14_aarch64_cortex-a53.ipk shadowsocksr-libev-ssr-check_2.5.6-r6_aarch64_cortex-a53.ipk shadowsocksr-libev-ssr-local_2.5.6-r6_aarch64_cortex-a53.ipk shadowsocksr-libev-ssr-redir_2.5.6-r6_aarch64_cortex-a53.ipk simple-obfs-client_0.0.5-r4_aarch64_cortex-a53.ipk tcping_0.3-r5_aarch64_cortex-a53.ipk"

    COUNT=3
    for file in $FILES; do
        COUNT=$((COUNT + 1))
        
        # LOG CHI TIẾT SANG FILE TẠM ĐỂ GỠ LỖI SSH
        DEBUG_LOG='/tmp/vpn_debug.log'
        
        # KIỂM TRA THÔNG MINH: Nếu đã có gói rồi thì bỏ qua để tránh tốn bộ nhớ
        PKG_NAME=$(echo "$file" | cut -d_ -f1)
        if opkg list-installed | grep -q "$PKG_NAME"; then
            echo "Đang chuẩn bị dữ liệu ($COUNT/18)..." >> "$LOG_FILE"
            echo "Skip $PKG_NAME: Already installed" >> "$DEBUG_LOG"
            continue
        fi

        echo "Đang chuẩn bị dữ liệu ($COUNT/18)..." >> "$LOG_FILE"
        curl -4 -f -s -L "$URL/$file" -o "$file"
        if [ $? -ne 0 ]; then
            echo "ERROR: Lỗi tải thành phần $COUNT!" >> "$LOG_FILE"
            rm -f "$LOCK_FILE"
            exit 1
        fi
        
        if echo "$file" | grep -q ".ipk"; then
            # CÀI ĐẶT THÔNG MINH: Thử cài đặt bình thường
            opkg install "$file" >> "$DEBUG_LOG" 2>&1
            if [ $? -ne 0 ]; then
                opkg install "$file" --force-depends >> "$DEBUG_LOG" 2>&1
                if [ $? -ne 0 ]; then
                    echo "ERROR: Lỗi cài thành phần $COUNT!" >> "$LOG_FILE"
                    rm -f "$LOCK_FILE"
                    exit 1
                fi
            fi
            rm -f "$file"
        fi
    done

    echo "Cài đặt thành công!" >> "$LOG_FILE"
    
    # Hoàn tất: Làm mới hệ thống
    rm -rf /tmp/luci-indexcache
    
    # Khởi động lại các service để nhận diện Menu mới mà không cần REBOOT
    /etc/init.d/rpcd restart >> "$DEBUG_LOG" 2>&1
    /etc/init.d/uhttpd restart >> "$DEBUG_LOG" 2>&1
    
    echo "Đang tinh chỉnh hệ thống..." >> "$LOG_FILE"
    rm -rf $TMP_DIR
    echo "SUCCESS: Kích hoạt hoàn tất!" >> "$LOG_FILE"
    rm -f "$LOCK_FILE"
) &

echo '{"status":"started"}'
