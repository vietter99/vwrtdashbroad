#!/bin/sh
echo 'Content-type: application/json'
echo ''

# CHUYỂN LOG SANG BỘ NHỚ FLASH ĐỂ KHÔNG MẤT KHI REBOOT
LOG_FILE='/www/vwrt/vpn_install.log'
LOCK_FILE='/tmp/vpn_install.lock'
URL="https://raw.githubusercontent.com/vietter99/vwrtdashbroad/main/vpn"
TMP_DIR="/tmp/core_update"

get_action() {
    echo "$QUERY_STRING" | grep -oE "action=[^&]+" | cut -d= -f2
}

ACTION=$(get_action)

if [ "$ACTION" = "status" ]; then
    if [ ! -f "$LOCK_FILE" ]; then
        if [ -f "$LOG_FILE" ] && grep -q "SUCCESS" "$LOG_FILE"; then
            echo '{"status":"success", "message":"CÀI ĐẶT HOÀN TẤT!"}'
        elif [ -f "$LOG_FILE" ] && grep -q "ERROR" "$LOG_FILE"; then
            MSG=$(tail -n 1 "$LOG_FILE")
            echo "{\"status\":\"error\", \"message\":\"$MSG\"}"
        else
            echo '{"status":"idle"}'
        fi
    else
        PROGRESS=$(tail -n 1 "$LOG_FILE" 2>/dev/null || echo "Đang khởi tạo...")
        echo "{\"status\":\"running\", \"progress\":\"$PROGRESS\"}"
    fi
    exit 0
fi

if [ -f "$LOCK_FILE" ]; then
    echo '{"status":"running", "message":"Cài đặt đang tiến hành..."}'
    exit 0
fi

touch "$LOCK_FILE"
echo "BẮT ĐẦU: Kết nối kho dữ liệu VWRT (Secure Mode)..." > "$LOG_FILE"

(
    # BẮT BUỘC: Cập nhật danh sách gốc
    echo "Đang cập nhật danh sách gói từ Server..." >> "$LOG_FILE"
    opkg update > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo "ERROR: Không thể kết nối Internet để cập nhật opkg!" >> "$LOG_FILE"
        rm -f "$LOCK_FILE"
        exit 1
    fi

    # Bước 0: Cài đặt các gói nền tảng từ official repo của ImmortalWrt
    echo "Đang tải các gói nền tảng" >> "$LOG_FILE"
    opkg install ip-full coreutils-base64 coreutils-nohup luci-compat luci-lib-ipkg jq nping > /dev/null 2>&1

    # Bước 1: Xử lý Dnsmasq (Bắt buộc phải là dnsmasq-full)
    if ! opkg list-installed | grep -q "dnsmasq-full"; then
        echo "Đang nâng cấp hệ thống DNS (Dnsmasq -> Dnsmasq-Full)..." >> "$LOG_FILE"
        opkg remove dnsmasq --force-remove > /dev/null 2>&1
        opkg install dnsmasq-full > /dev/null 2>&1
    fi

    rm -rf $TMP_DIR && mkdir -p $TMP_DIR
    cd $TMP_DIR
    
    FILES="libuci-lua_2021-04-14-1_aarch64_cortex-a53.ipk luci-app-ssr-plus_190-r126_all.ipk xray-core_25.12.8-r35_aarch64_cortex-a53.ipk luci-app-mosdns_1.6.16-r18_all.ipk mosdns_5.3.3-r82_aarch64_cortex-a53.ipk dns2socks_2.1-r4_aarch64_cortex-a53.ipk dns2tcp_1.1.2-r2_aarch64_cortex-a53.ipk lua-neturl_1.2.1-r4_all.ipk microsocks_1.0.5-r3_aarch64_cortex-a53.ipk shadowsocks-rust-sslocal_1.24.0-r14_aarch64_cortex-a53.ipk shadowsocks-rust-ssserver_1.24.0-r14_aarch64_cortex-a53.ipk shadowsocksr-libev-ssr-check_2.5.6-r6_aarch64_cortex-a53.ipk shadowsocksr-libev-ssr-local_2.5.6-r6_aarch64_cortex-a53.ipk shadowsocksr-libev-ssr-redir_2.5.6-r6_aarch64_cortex-a53.ipk simple-obfs-client_0.0.5-r4_aarch64_cortex-a53.ipk tcping_0.3-r5_aarch64_cortex-a53.ipk"

    for file in $FILES; do
        echo "Đang tải thành phần hệ thống..." >> "$LOG_FILE"
        curl -4 -f -s -L "$URL/$file" -o "$file"
        if [ $? -ne 0 ]; then
            echo "ERROR: Không thể tải dữ liệu từ Server!" >> "$LOG_FILE"
            rm -f "$LOCK_FILE"
            exit 1
        fi
        
        if echo "$file" | grep -q ".ipk"; then
            echo "Đang giải mã và cài đặt gói..." >> "$LOG_FILE"
            
            # ĐỐI VỚI GÓI CHÍNH: Ép cài đặt để bypass lỗi libuci-lua ảo trên bản 24.10
            if echo "$file" | grep -q "luci-app-ssr-plus"; then
                opkg install "$file" --force-depends > /dev/null 2>&1
            else
                # Các gói khác cài bình thường để đảm bảo ổn định
                OUT=$(opkg install "$file" 2>&1)
                if [ $? -ne 0 ]; then
                    opkg install "$file" --force-depends > /dev/null 2>&1
                fi
            fi
            rm -f "$file"
        fi
    done

    echo "Cấu hình hệ thống VWRT..." >> "$LOG_FILE"
    
    # BẮT BUỘC: Khởi tạo file cấu hình nếu gói không tự tạo (fix lỗi trắng trang)
    if [ ! -f "/etc/config/shadowsocksr" ]; then
        echo "Khởi tạo file cấu hình shadowsocksr..." >> "$LOG_FILE"
        touch /etc/config/shadowsocksr
        uci -q batch <<EOF
set shadowsocksr.global=global
set shadowsocksr.global.enabled=0
commit shadowsocksr
EOF
    fi
    
    # Hoàn tất: Làm mới hệ thống
    rm -rf /tmp/luci-indexcache
    
    # Khởi động lại các service để nhận diện Menu mới mà không cần REBOOT
    /etc/init.d/rpcd restart >/dev/null 2>&1
    /etc/init.d/uhttpd restart >/dev/null 2>&1
    
    echo "Dọn dẹp..." >> "$LOG_FILE"
    rm -rf $TMP_DIR
    echo "SUCCESS: Kích hoạt hoàn tất!" >> "$LOG_FILE"
    rm -f "$LOCK_FILE"
) &

echo '{"status":"started"}'
