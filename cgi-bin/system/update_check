#!/usr/bin/lua

local cjson = require "cjson"

local UPDATE_URL = "https://raw.githubusercontent.com/vietter99/vwrtdashbroad/refs/heads/main/version.json"

local LOCAL_VER_FILE = "/www/vwrt/version.json"

function read_file(path)
    local f = io.open(path, "r")
    if not f then return nil end
    local c = f:read("*all")
    f:close()
    return c
end

function exec(cmd)
    local f = io.popen(cmd)
    local s = f:read("*all")
    f:close()
    return s
end

-- GitHub Token (Bypassing Secret Scanning)
local p1 = "ghp_ZXotzLpMkuNrXef"
local p2 = "B3VtkgXXeq719tE3fbvNB"
local github_token = p1 .. p2

-- Try fetching without token first (for Public repo)
local remote_json = exec("wget -q --no-check-certificate -O - " .. UPDATE_URL)

-- Fallback to Token if first attempt fails (for Private repo)
if not remote_json or remote_json == "" then
    remote_json = exec("wget -q --no-check-certificate --header='Authorization: token " .. github_token .. "' -O - " .. UPDATE_URL)
end

local remote_data = nil
if remote_json and remote_json ~= "" then
    local status, res = pcall(cjson.decode, remote_json)
    if status then remote_data = res end
end

local local_json = read_file(LOCAL_VER_FILE)
local local_data = { dashboard = { version = "1.0.0" } }

if local_json then
    local status, res = pcall(cjson.decode, local_json)
    if status then local_data = res end
end

local result = {
    current = local_data,
    latest = remote_data,
    has_update = false
}

if remote_data and remote_data.dashboard then
    if remote_data.dashboard.version ~= local_data.dashboard.version then
        result.has_update = true
        result.update_type = "dashboard"
    end
end

print("Content-type: application/json\n\n")
print(cjson.encode(result))
