#!/usr/bin/lua

-- Log helper
local function log(msg)
    os.execute("logger -t timewrt '" .. msg .. "'")
    print("timewrt: " .. msg)
end

-- UCI helper (Đọc trạng thái service)
local function uci_enabled(pkg, section, option)
    local cmd = string.format("uci -q get %s.%s.%s", pkg, section or "@global[0]", option or "enabled")
    local handle = io.popen(cmd)
    local val = handle:read("*a"):gsub("%s+", "")
    handle:close()
    return val == "1"
end

-- Danh sách các dịch vụ VPN cần quản lý
local vpn_services = {
    {name = "OpenClash", init = "openclash", pkg = "openclash", section = "config", opt = "enable"},
    {name = "Passwall", init = "passwall", pkg = "passwall", section = "@global[0]", opt = "enabled"},
    {name = "Passwall2", init = "passwall2", pkg = "passwall2", section = "@global[0]", opt = "enabled"},
    {name = "SSR Plus", init = "shadowsocksr", pkg = "shadowsocksr", section = "@global[0]", opt = "enable_switch"},
    {name = "v2ray", init = "v2ray", pkg = "v2ray", section = "enabled", opt = "enabled"},
    {name = "v2rayA", init = "v2raya", pkg = "v2raya", section = "config", opt = "enabled"},
    {name = "Xray", init = "xray", pkg = "xray", section = "enabled", opt = "enabled"}
}

-- Lấy danh sách DNS nhà mạng từ hệ thống (Cách của Watchdog chuẩn)
local function get_isp_dns()
    local dns_list = {}
    local iface = "5G"
    local handle = io.popen("ubus call network.interface." .. iface .. " status 2>/dev/null")
    local status = handle:read("*a")
    handle:close()
    
    if status and status ~= "" then
        -- Khoanh vùng đúng mục dns-server
        local dns_section = status:match('"dns%-server":%s*%[(.-)%]')
        if dns_section then
            for dns in dns_section:gmatch('"([^"]+)"') do
                if dns:match("^%d+%.%d+%.%d+%.%d+$") then -- Chỉ lấy IPv4
                    if dns ~= "8.8.8.8" and dns ~= "8.8.4.4" and dns ~= "1.1.1.1" then
                        table.insert(dns_list, dns)
                    end
                end
            end
        end
    end
    return dns_list
end

local function manage_vpns(action)
    log("Đang " .. (action == "stop" and "tạm dừng" or "khởi động lại") .. " các dịch vụ VPN...")
    for _, svc in ipairs(vpn_services) do
        local check_file = "/etc/init.d/" .. svc.init
        if os.execute("test -f " .. check_file) == 0 then
            -- Chỉ xử lý nếu dịch vụ đang được bật (enabled) trong cấu hình
            if uci_enabled(svc.pkg, svc.section, svc.opt) then
                log("  -> " .. svc.name .. "...")
                os.execute(check_file .. " " .. action .. " >/dev/null 2>&1")
            end
        end
    end
end

-- Danh sách máy chủ dự phòng (Fallback) - Ưu tiên các trang trong nước cho Bypass SIM
local fallback_hosts = {
    "m.tv360.vn",
    "tv360.vn",
    "vtvgo.vn",
    "vnexpress.net"
}

-- Logic đồng bộ thời gian chính
local function sync(host)
    local hosts_to_try = { host }
    for _, h in ipairs(fallback_hosts) do 
        if h ~= host then table.insert(hosts_to_try, h) end 
    end

    local success = false
    for _, current_host in ipairs(hosts_to_try) do
        local clean_host = current_host:gsub("^https?://", "")
        local url = "http://" .. clean_host

        log("Đang thử lấy giờ từ: " .. url)
        
        -- Thử phân giải IP bằng DNS nhà mạng trước để tránh treo DNSmasq
        local isp_dns = get_isp_dns()
        local resolved_ip = nil
        for _, dns in ipairs(isp_dns) do
            local h = io.popen(string.format("nslookup %s %s 2>/dev/null", clean_host, dns))
            local found_name = false
            for line in h:lines() do
                if line:find("Name:") then found_name = true end
                if found_name and line:find("Address") then
                    resolved_ip = line:match("Address%s*:%s*([%d%.]+)")
                    if resolved_ip then break end
                end
            end
            h:close()
            if resolved_ip and resolved_ip ~= "" then 
                log("  -> Phân giải " .. clean_host .. " qua DNS " .. dns .. " thành công: " .. resolved_ip)
                break 
            end
        end

        local curl_cmd
        if resolved_ip and resolved_ip ~= "" then
            -- Nếu có IP, ép curl dùng IP đó và gửi Host header
            curl_cmd = string.format("curl -Is -H 'Host: %s' http://%s --connect-timeout 6 --retry 1 | grep -i '^Date:'", clean_host, resolved_ip)
        else
            -- Nếu không, dùng curl mặc định (fallback)
            curl_cmd = string.format("curl -Is '%s' --connect-timeout 6 --retry 1 | grep -i '^Date:'", url)
        end

        local handle = io.popen(curl_cmd)
        local date_header = handle:read("*a")
        handle:close()

        if date_header and date_header ~= "" then
            -- Định dạng Date mẫu: Date: Sun, 19 Apr 2026 06:12:34 GMT
            local day, month_str, year, hour, min, sec = date_header:match("%a+, (%d+) (%a+) (%d+) (%d+):(%d+):(%d+)")
            
            if day then
                local months = {
                    Jan="01", Feb="02", Mar="03", Apr="04", May="05", Jun="06",
                    Jul="07", Aug="08", Sep="09", Oct="10", Nov="11", Dec="12"
                }
                local month = months[month_str]
                if month then
                    -- Format date cho BusyBox: YYYY.MM.DD-HH:MM:SS
                    local date_cmd = string.format("date -u -s '%s.%s.%s-%s:%s:%s' >/dev/null 2>&1", year, month, day, hour, min, sec)
                    if os.execute(date_cmd) == 0 then
                        log("Cập nhật giờ hệ thống thành công từ " .. clean_host)
                        log("Giờ hiện tại: " .. io.popen("date"):read("*a"):gsub("\n", ""))
                        success = true
                        break
                    end
                end
            end
        end
        log("  -> Máy chủ " .. clean_host .. " không phản hồi hoặc bị chặn.")
    end

    if not success then
        log("LỖI: Tất cả các máy chủ thời gian đều không khả dụng.")
    end
    return success
end

-- Entry point
local target = arg[1]
local mode = arg[2]

-- Nếu không nhập host, lấy mặc định từ danh sách dự phòng (m.tv360.vn)
if not target or target == "" or target == "cron" then
    if target == "cron" then mode = "cron" end
    target = fallback_hosts[1]
end

if mode == "cron" then
    -- Chế độ định kỳ (Cron): Chỉ làm nếu không thể kết nối tới server thời gian
    local check = os.execute("curl -Is --connect-timeout 3 http://" .. target:gsub("^https?://", "") .. " | grep -q 'Date:'")
    if check ~= 0 then
        log("Cron phát hiện mất mạng hoặc lệch giờ. Tiến hành Reset...")
        manage_vpns("stop")
        sync(target)
        manage_vpns("start")
    end
else
    -- Chế độ chạy thủ công (Sync ngay lập tức)
    manage_vpns("stop")
    sync(target)
    manage_vpns("start")
end
