#!/usr/bin/lua

local cjson = require "cjson"

function read_post_data()
    local len = os.getenv("CONTENT_LENGTH")
    if not len then return nil end
    local content = io.read(tonumber(len))
    return content
end

function send_response(status, message)
    print("Content-type: application/json\n")
    print(cjson.encode({ status = status, message = message }))
end

local post_data = read_post_data()

if not post_data or post_data == "" then
    send_response("error", "No data received")
    os.exit(0)
end

local ok, data = pcall(cjson.decode, post_data)

if not ok or not data then
    send_response("error", "Invalid JSON")
    os.exit(0)
end

local user = data.username
local pass = data.password

if not user or user == "" or not pass or pass == "" then
    send_response("error", "Missing username or password")
    os.exit(0)
end

-- Validate user (basic check)
if user ~= "root" and user ~= "admin" then
    send_response("error", "Only root/admin allowed")
    os.exit(0)
end

-- Execute passwd command
-- OpenWrt: echo -e "password\npassword" | passwd root
local cmd = string.format("echo -e '%s\\n%s' | passwd %s >/dev/null 2>&1", pass, pass, user)
local result = os.execute(cmd)

if result == 0 or result == true then
    send_response("success", "Đã đổi mật khẩu thành công cho user: " .. user)
else
    send_response("error", "Lỗi hệ thống khi đổi mật khẩu")
end
