#!/bin/sh

echo "Content-type: application/json"
echo ""

URL="https://github.com/vietter99/vwrtdashbroad/archive/refs/heads/main.tar.gz"

LOGfile="/tmp/update_debug.log"
echo "Update Start: Forced URL=$URL" > $LOGfile

WORKDIR="/tmp/update_work"

download_file() {
    if command -v curl >/dev/null 2>&1; then
        curl -k -L -o "$2" "$1" >> $LOGfile 2>&1
    elif command -v wget >/dev/null 2>&1; then
        wget --no-check-certificate -O "$2" "$1" >> $LOGfile 2>&1
    else
        return 1
    fi
}

rm -rf $WORKDIR
mkdir -p $WORKDIR
cd $WORKDIR

if download_file "$URL" "update.tar.gz"; then
    
    if [ ! -s "update.tar.gz" ]; then
         echo '{"status":"error", "message":"Lỗi: File tải về bị rỗng (0 byte)"}'
         exit 0
    fi

    if tar -xzf update.tar.gz -C $WORKDIR >/tmp/tar_error.txt 2>&1; then
        
        FOLDER=$(ls -d $WORKDIR/*/ 2>/dev/null | head -n 1)
        if [ -z "$FOLDER" ]; then
             FOLDER=$(find $WORKDIR -maxdepth 1 -type d | grep -v "^$WORKDIR$" | head -n 1)
        fi

        if [ -z "$FOLDER" ]; then
             echo '{"status":"error", "message":"Giải nén OK nhưng không tìm thấy thư mục code."}'
             exit 0
        fi

        cat <<EOF > /tmp/do_clean_install.sh
#!/bin/sh
sleep 2

# 1. Xóa sạch dữ liệu cũ
rm -rf /www/vwrt/*

# 2. Xử lý cài đặt thông minh (Auto detect structure)
if [ -d "$FOLDER/backend" ]; then
    # === CẤU TRÚC MỚI ===
    cp -rf "$FOLDER/frontend/"* /www/vwrt/
    mkdir -p /www/vwrt/cgi-bin /www/vwrt/services
    cp -rf "$FOLDER/backend/api/"* /www/vwrt/cgi-bin/
    cp -rf "$FOLDER/backend/services/"* /www/vwrt/services/
    
    # 2.4 Copy Version
    if [ -f "$FOLDER/version.json" ]; then
        cp "$FOLDER/version.json" /www/vwrt/
    fi
else
    # === CẤU TRÚC CŨ ===
    cp -rf "$FOLDER"/* /www/vwrt/
fi

# 3. Cấp quyền
chmod -R 755 /www/vwrt
chmod +x /www/vwrt/cgi-bin/*
chmod +x /www/vwrt/cgi-bin/*/* 2>/dev/null
chmod +x /www/vwrt/services/* 2>/dev/null

# 4. Restart Services
killall mobile_poller.sh 2>/dev/null
if [ -f "/www/vwrt/services/mobile_poller.sh" ]; then
    sh /www/vwrt/services/mobile_poller.sh &
elif [ -f "/www/vwrt/cgi-bin/mobile_poller.sh" ]; then
    sh /www/vwrt/cgi-bin/mobile_poller.sh &
fi

# 5. Dọn dẹp
rm -rf $WORKDIR

# 6. Reboot
reboot
EOF
        chmod +x /tmp/do_clean_install.sh
        
        sh /tmp/do_clean_install.sh >/dev/null 2>&1 &

        echo '{"status":"success", "message":"Tải bản cập nhật thành công! Hệ thống đang cài đặt lại và sẽ tự khởi động lại sau 1 phút."}'
    else
        ERR_MSG=$(cat /tmp/tar_error.txt)
        SAFE_ERR=$(echo "$ERR_MSG" | sed 's/"/\\"/g')
        echo "{\"status\":\"error\", \"message\":\"Lỗi lệnh TAR: $SAFE_ERR\"}"
    fi
else
    echo '{"status":"error", "message":"Không tải được file từ GitHub."}'
fi