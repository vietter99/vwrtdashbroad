#!/usr/bin/lua
-- AdBlock Fast Set API
-- Params: enabled (bool), lists (array of enabled list names)

local json = require("luci.jsonc")
local uci = require("luci.model.uci").cursor()

print("Content-Type: application/json")
print("")

local function urldecode(str)
    str = str:gsub('+', ' ')
    str = str:gsub('%%(%x%x)', function(h)
        return string.char(tonumber(h, 16))
    end)
    return str
end

local function parse_post_data()
    local content_length = tonumber(os.getenv("CONTENT_LENGTH") or 0)
    if content_length > 0 then
        local raw = io.read(content_length)
        return json.parse(raw) or {}
    end
    return {}
end

local function set_config()
    local data = parse_post_data()
    
    -- Set global enabled status
    if data.enabled ~= nil then
        local val = data.enabled and "1" or "0"
        uci:set("adblock-fast", "config", "enabled", val)
    end
    
    -- Update list enabled status
    if data.lists and type(data.lists) == "table" then
        -- Build a set of enabled list names
        local enabled_set = {}
        for _, name in ipairs(data.lists) do
            enabled_set[name] = true
        end
        
        -- Iterate through all lists and update enabled status
        uci:foreach("adblock-fast", "file_url", function(s)
            local name = s.name or ""
            local should_enable = enabled_set[name] and "1" or "0"
            
            -- Get the section name (e.g. @file_url[0])
            uci:set("adblock-fast", s[".name"], "enabled", should_enable)
        end)
    end
    
    -- Commit changes
    uci:commit("adblock-fast")
    
    -- Reload/restart adblock-fast service
    os.execute("/etc/init.d/adblock-fast reload >/dev/null 2>&1 &")
    
    print(json.stringify({ success = true, message = "Cấu hình đã được lưu." }))
end

-- Handle request
local ok, err = pcall(set_config)
if not ok then
    print(json.stringify({ success = false, error = tostring(err) }))
end
